{"id":"c1a3b25f-efe1-42d5-b502-a686d1163c0c","updated_at":"2026-05-16T15:25:55.308Z","updated_by":"elastic","created_at":"2026-05-16T15:25:55.308Z","created_by":"elastic","name":"Abnormal User Behavior - Insider Threat Detection","tags":["Insider-Threat","T1078","MITRE"],"interval":"5m","enabled":true,"revision":0,"description":"Detects suspicious user authentication activity including logins during unusual hours (10PM-5AM) or from outside the trusted network range. Mapped to MITRE ATT&CK T1078 - Valid Accounts.","risk_score":47,"severity":"medium","license":"","output_index":"","meta":{"kibana_siem_app_url":"http://localhost:5601/app/security"},"author":[],"false_positives":[],"from":"now-6m","rule_id":"6a734baa-f48e-494b-a8a0-26fe34ec0140","max_signals":100,"risk_score_mapping":[],"severity_mapping":[],"threat":[{"framework":"MITRE ATT&CK","tactic":{"id":"TA0005","name":"Defense Evasion","reference":"https://attack.mitre.org/tactics/TA0005/"},"technique":[{"id":"T1078","name":"Valid Accounts","reference":"https://attack.mitre.org/techniques/T1078/","subtechnique":[]}]}],"to":"now","references":["https://attack.mitre.org/techniques/T1078/"],"version":1,"exceptions_list":[],"immutable":false,"rule_source":{"type":"internal"},"related_integrations":[],"required_fields":[],"setup":"","type":"query","language":"kuery","index":["apm-*-transaction*","auditbeat-*","endgame-*","filebeat-*","logs-*","packetbeat-*","traces-apm*","winlogbeat-*","-*elastic-cloud-logs-*"],"query":"event.category: \"authentication\" and event.outcome: \"success\" and (hour_of_day >= 22 or hour_of_day <= 5) or (source.ip: * and not source.ip: \"192.168.0.0/24\")","filters":[],"actions":[]}
{"id":"d652b863-9a97-449b-97f3-20b66486c608","updated_at":"2026-05-16T15:28:43.443Z","updated_by":"elastic","created_at":"2026-05-16T11:02:31.095Z","created_by":"elastic","name":"C2 Beacon Detection - Suspicious Outbound Connection","tags":["C2","T1071.001","MITRE"],"interval":"5m","enabled":true,"revision":2,"description":"Detects potential C2 beacon activity via outbound connections to common attacker ports (4444, 1337, 8080, 9001). Mapped to MITRE ATT&CK T1071.001 - Application Layer Protocol.","risk_score":73,"severity":"high","license":"","output_index":"","meta":{"kibana_siem_app_url":"http://localhost:5601/app/security"},"author":[],"false_positives":["Legitimate applications using port 8080 for web traffic"],"from":"now-6m","rule_id":"d2db6a51-8fc4-4001-a391-8f234d3973f5","max_signals":100,"risk_score_mapping":[],"severity_mapping":[],"threat":[{"framework":"MITRE ATT&CK","tactic":{"id":"TA0011","name":"Command and Control","reference":"https://attack.mitre.org/tactics/TA0011/"},"technique":[{"id":"T1071","name":"Application Layer Protocol","reference":"https://attack.mitre.org/techniques/T1071/","subtechnique":[{"id":"T1071.001","name":"Web Protocols","reference":"https://attack.mitre.org/techniques/T1071/001/"}]}]}],"to":"now","references":["https://attack.mitre.org/techniques/T1071/001/"],"version":1,"exceptions_list":[],"immutable":false,"rule_source":{"type":"internal"},"related_integrations":[],"required_fields":[],"setup":"","type":"query","language":"kuery","index":["apm-*-transaction*","auditbeat-*","endgame-*","filebeat-*","logs-*","packetbeat-*","traces-apm*","winlogbeat-*","-*elastic-cloud-logs-*"],"query":"network.protocol: \"tcp\" and destination.port: (4444 or 1337 or 8080 or 9001) and event.action: \"network_flow\"","filters":[],"actions":[]}
{"id":"95c72230-7b45-430d-8ce2-821d69b8364f","updated_at":"2026-05-16T15:13:28.689Z","updated_by":"elastic","created_at":"2026-05-16T15:13:28.689Z","created_by":"elastic","name":"Phishing Payload Execution - Office App Spawning Shell","tags":["Phishing","T1566.001","MITRE"],"interval":"5m","enabled":true,"revision":0,"description":"Detects phishing payload execution where Office applications or email clients spawn suspicious child processes like PowerShell or CMD. Mapped to MITRE ATT&CK T1566.001 - Phishing: Spearphishing Attachment.","risk_score":75,"severity":"high","license":"","output_index":"","meta":{"kibana_siem_app_url":"http://localhost:5601/app/security"},"author":[],"false_positives":[],"from":"now-6m","rule_id":"579fc3d5-2c61-4e81-8c82-7cf6f0c4686d","max_signals":100,"risk_score_mapping":[],"severity_mapping":[],"threat":[{"framework":"MITRE ATT&CK","tactic":{"id":"TA0001","name":"Initial Access","reference":"https://attack.mitre.org/tactics/TA0001/"},"technique":[{"id":"T1566","name":"Phishing","reference":"https://attack.mitre.org/techniques/T1566/","subtechnique":[{"id":"T1566.001","name":"Spearphishing Attachment","reference":"https://attack.mitre.org/techniques/T1566/001/"}]}]}],"to":"now","references":["https://attack.mitre.org/techniques/T1566/001/"],"version":1,"exceptions_list":[],"immutable":false,"rule_source":{"type":"internal"},"related_integrations":[],"required_fields":[],"setup":"","type":"query","language":"kuery","index":["apm-*-transaction*","auditbeat-*","endgame-*","filebeat-*","logs-*","packetbeat-*","traces-apm*","winlogbeat-*","-*elastic-cloud-logs-*"],"query":"process.name: (\"powershell.exe\" or \"cmd.exe\" or \"wscript.exe\" or \"mshta.exe\") and process.parent.name: (\"outlook.exe\" or \"winword.exe\" or \"excel.exe\" or \"thunderbird.exe\")","filters":[],"actions":[]}
